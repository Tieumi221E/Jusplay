{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jusplay.invalid/schema/capture/0",
  "title": "jusplay snapshot capture record v0",
  "type": "object",
  "required": ["schema", "snapshotId", "videoId", "origin", "capturedFrom", "capturedTo", "collector", "targets", "pageDisplayProfile", "responses"],
  "properties": {
    "schema": { "enum": ["jusplay-capture/0", "kantanplay-capture/0"] },
    "snapshotId": { "$ref": "#/$defs/uuid" },
    "videoId": { "description": "Niconico video id; empty when not known", "type": "string", "pattern": "^([a-z]{2}[0-9]+)?$" },
    "origin": { "enum": ["nv-comment-v1", "legacy-xml", "comment-zouryou-json"] },
    "capturedFrom": { "$ref": "#/$defs/timeOrNull" },
    "capturedTo": { "$ref": "#/$defs/timeOrNull" },
    "collector": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    },
    "pageDisplayProfile": {
      "oneOf": [
        { "const": "unknown" },
        { "type": "object" }
      ]
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/response" }
    },
    "extra": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "nv-comment-v1" } } },
      "then": {
        "properties": {
          "capturedFrom": { "type": "string" },
          "capturedTo": { "type": "string" },
          "responses": { "items": { "properties": { "format": { "const": "nv-comment-v1" } } } }
        }
      }
    },
    {
      "if": { "properties": { "origin": { "const": "legacy-xml" } } },
      "then": {
        "properties": {
          "responses": { "maxItems": 1, "items": { "properties": { "format": { "const": "legacy-xml" } } } }
        }
      }
    },
    {
      "if": { "properties": { "origin": { "const": "comment-zouryou-json" } } },
      "then": {
        "properties": {
          "responses": { "maxItems": 1, "items": { "properties": { "format": { "const": "comment-zouryou-json" } } } }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timeOrNull": {
      "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }]
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "required": ["threadId", "fork"],
      "properties": {
        "threadId": { "type": "string", "minLength": 1 },
        "fork": { "type": "string", "minLength": 1 },
        "extra": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "format", "fetchedAt", "target", "window", "httpStatus"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^responses/[0-9]{6}\\.(json|xml)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "format": { "enum": ["nv-comment-v1", "legacy-xml", "comment-zouryou-json"] },
        "fetchedAt": { "$ref": "#/$defs/timeOrNull" },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }]
        },
        "window": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "when": { "type": "integer" }
              }
            }
          ]
        },
        "httpStatus": { "type": ["integer", "null"] },
        "apiStatus": { "type": ["integer", "null"] }
      }
    }
  }
}
